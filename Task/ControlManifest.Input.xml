<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="secNueva" constructor="NuevaVersionTask" version="2.2.22" display-name-key="Nueva Version Task" description-key="Task Control - Gestión de Instalaciones y Materiales" control-type="standard">
    
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>

    <external-service-usage enabled="false" />

    <property name="dependencia_fechas" display-name-key="Dependencia de Fechas Padre-Hija" description-key="Si está activo, las fechas de la tarea padre se calculan automáticamente." of-type="TwoOptions" usage="input" default-value="true" />
    <property name="modulo_productos" display-name-key="Módulo de Productos" description-key="Habilitar/Deshabilitar panel, columna y carga de Productos" of-type="TwoOptions" usage="input" default-value="true" />
    
    <data-set name="sampleDataSet" display-name-key="Dataset de Tareas">
      <property-set name="sec_idtarea" display-name-key="ID" of-type="SingleLine.Text" usage="bound" required="true" />
      <property-set name="sec_name" display-name-key="Nombre" of-type="SingleLine.Text" usage="bound" required="true" />
      <property-set name="sec_inicio" display-name-key="Inicio" of-type="DateAndTime.DateOnly" usage="bound" required="false" />
      <property-set name="sec_fin" display-name-key="Finalización" of-type="DateAndTime.DateOnly" usage="bound" required="false" />
      <property-set name="sec_esfuerzoestimado" display-name-key="Esfuerzo Estimado" of-type="Decimal" usage="bound" required="false" />
      <property-set name="sec_horasimputadas" display-name-key="Horas Imputadas" of-type="Decimal" usage="bound" required="false" />
      <property-set name="sec_progreso" display-name-key="Progreso" of-type="Whole.None" usage="bound" required="false" />
      <property-set name="statuscode" display-name-key="Razón Estado" of-type="OptionSet" usage="bound" required="false" />
      <property-set name="sec_tareaprincipalid" display-name-key="Tarea Principal" of-type="Lookup.Simple" usage="bound" required="false" />
      <property-set name="sec_dependenciaid" display-name-key="Dependencia" of-type="Lookup.Simple" usage="bound" required="false" />
    </data-set>

    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/Task.css" order="2" />
      <resx path="strings/TaskControl.1033.resx" version="1.0.0" />
      <resx path="strings/TaskControl.3082.resx" version="1.0.0" />
      <resx path="strings/TaskControl.2070.resx" version="1.0.0" />
    </resources>
  </control>
</manifest>